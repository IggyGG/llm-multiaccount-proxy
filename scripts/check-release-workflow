#!/usr/bin/env python3
"""Reject the release race that uploads binaries before a release exists."""

from pathlib import Path
import sys


workflow = Path(".github/workflows/release.yml").read_text(encoding="utf-8")
required = {
    "a release-draft job": "\n  release-draft:\n",
    "binaries waiting for the draft": "\n  binaries:\n    needs: release-draft\n",
    "the container waiting for the draft": "\n  container:\n    needs: release-draft\n",
    "a terminal publish job": "\n  publish-release:\n    needs: [binaries, container]\n",
    "draft creation before uploads": 'gh release create "${GITHUB_REF_NAME}"',
    "publication after uploads": 'gh release edit "${GITHUB_REF_NAME}"',
    "repository context for checkout-free jobs": "GH_REPO: ${{ github.repository }}",
}

missing = [name for name, fragment in required.items() if fragment not in workflow]
if workflow.count("GH_REPO: ${{ github.repository }}") < 2:
    missing.append("repository context on both checkout-free release jobs")
if missing:
    print("release-workflow check failed:", file=sys.stderr)
    for name in missing:
        print(f"  missing {name}", file=sys.stderr)
    raise SystemExit(1)

print("release-workflow check passed: draft precedes parallel uploads")
